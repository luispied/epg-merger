{
  "name": "grilla-worker",
  "version": "1.74.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "npx --yes -p typescript@5.9 tsc -p . --noEmit && npx --yes -p typescript@5.9 tsc -p web --noEmit",
    "test": "node --test test/*.test.ts",
    "deploy": "wrangler deploy",
    "e2e": "node build.mjs && playwright test",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "splash-images": "node build.mjs && node splash-images.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "^0.25.0",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
